# EXPO_PUBLIC_ ile başlayan değerler uygulama paketine gömülür; buraya sır eklemeyin.
EXPO_PUBLIC_APP_ENV=development
# Genymotion: http://10.0.3.2:3001/api | Android Emulator: http://10.0.2.2:3001/api
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3001/api
EXPO_PUBLIC_DATA_SOURCE=mock
EXPO_PUBLIC_MOCK_DELAY_MIN_MS=300
EXPO_PUBLIC_MOCK_DELAY_MAX_MS=800
# success | intermittent-error | always-error
EXPO_PUBLIC_MOCK_SCENARIO=success
